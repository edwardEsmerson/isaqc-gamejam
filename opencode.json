{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "pixellab": {
      "type": "remote",
      "url": "https://api.pixellab.ai/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:PIXELLAB_API_KEY}"
      },
      "timeout": 60000
    }
  }
}
