{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".agents/skills"]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "--prefer-offline",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--caps",
        "vision"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "enabled": true,
      "timeout": 30000
    }
  }
}
